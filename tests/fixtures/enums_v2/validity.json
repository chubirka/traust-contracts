{
  "name": "validity",
  "description": "Is the claim, as written, true? Illustrative fixture for the v2 format test, not a decided vocabulary: values follow the assessment's proposal and are pending the plan's decisions.",
  "values": [
    "not_assessed",
    "inconclusive",
    "true_positive",
    "false_positive"
  ],
  "definitions": {
    "not_assessed": "not_assessed (illustrative).",
    "inconclusive": "inconclusive (illustrative).",
    "true_positive": "true_positive (illustrative).",
    "false_positive": "false_positive (illustrative)."
  },
  "standard": {
    "name": "SAST triage true/false positive",
    "relationship": "adapted",
    "note": "Adds not_assessed and inconclusive."
  },
  "since": "0.43.0",
  "replaces_v1": [
    "validity",
    "event_validity",
    "verdict",
    "triage_verify_verdict"
  ],
